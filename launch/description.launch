<launch>
  <arg name="base_frame_id" default="base_footprint"/>
  <arg name="base_link_frame_id" default="base_link"/>
  <arg name="imu_frame_id" default="imu_link"/>
  <arg name="laser_frame_id" default="laser_frame"/>
  <arg name="base_link_x" default="0.0"/>
  <arg name="base_link_y" default="0.0"/>
  <arg name="base_link_z" default="0.0"/>
  <arg name="imu_x" default="0.0"/>
  <arg name="imu_y" default="0.0"/>
  <arg name="imu_z" default="0.06"/>
  <arg name="laser_x" default="0.12"/>
  <arg name="laser_y" default="0.0"/>
  <arg name="laser_z" default="0.12"/>
  <arg name="laser_yaw" default="0.0"/>

  <node pkg="tf2_ros" type="static_transform_publisher" name="base_footprint_to_base_link"
        args="$(arg base_link_x) $(arg base_link_y) $(arg base_link_z) 0.0 0.0 0.0 $(arg base_frame_id) $(arg base_link_frame_id)"/>
  <node pkg="tf2_ros" type="static_transform_publisher" name="base_link_to_imu"
        args="$(arg imu_x) $(arg imu_y) $(arg imu_z) 0.0 0.0 0.0 $(arg base_link_frame_id) $(arg imu_frame_id)"/>
  <node pkg="tf2_ros" type="static_transform_publisher" name="base_link_to_laser"
        args="$(arg laser_x) $(arg laser_y) $(arg laser_z) $(arg laser_yaw) 0.0 0.0 $(arg base_link_frame_id) $(arg laser_frame_id)"/>
</launch>
