<launch>
  <arg name="port" default="/dev/osrbot_base"/>
  <arg name="baudrate" default="460800"/>
  <arg name="wheelbase" default="0.325"/>
  <arg name="max_speed" default="0.8"/>
  <arg name="speed_mode" default="high"/>
  <arg name="max_steering_angle" default="0.5235987756"/>
  <arg name="cmd_timeout" default="0.5"/>
  <arg name="odom_frame_id" default="odom"/>
  <arg name="base_frame_id" default="base_footprint"/>
  <arg name="imu_frame_id" default="imu_link"/>
  <arg name="publish_tf" default="true"/>
  <arg name="rviz_config" default="$(find osracer_base)/rviz/odom_view.rviz"/>

  <include file="$(find osracer_base)/launch/chassis_driver.launch">
    <arg name="port" value="$(arg port)"/>
    <arg name="baudrate" value="$(arg baudrate)"/>
    <arg name="wheelbase" value="$(arg wheelbase)"/>
    <arg name="max_speed" value="$(arg max_speed)"/>
    <arg name="speed_mode" value="$(arg speed_mode)"/>
    <arg name="max_steering_angle" value="$(arg max_steering_angle)"/>
    <arg name="cmd_timeout" value="$(arg cmd_timeout)"/>
    <arg name="odom_frame_id" value="$(arg odom_frame_id)"/>
    <arg name="base_frame_id" value="$(arg base_frame_id)"/>
    <arg name="imu_frame_id" value="$(arg imu_frame_id)"/>
    <arg name="publish_tf" value="$(arg publish_tf)"/>
  </include>

  <node pkg="rviz" type="rviz" name="rviz" output="screen" args="-d $(arg rviz_config)"/>
</launch>
